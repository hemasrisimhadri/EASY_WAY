# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# If empty or unreachable, server will automatically fallback to in-memory MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/easyway

# Authentication & Security
JWT_SECRET=easyway_healthcare_super_secret_jwt_key_2026

# Client / CORS Configuration
CLIENT_URL=http://localhost:5174

# Customer Care Phone (Optional - displays 'Customer Care: Coming Soon' if unset)
EASYWAY_CUSTOMER_CARE_PHONE=
